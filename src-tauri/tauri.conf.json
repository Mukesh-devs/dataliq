{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DataLiq",
  "version": "1.0.0",
  "identifier": "app.dataliq.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DataLiq",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Open huge tabular files instantly",
    "longDescription": "DataLiq opens huge CSV, Parquet, JSON and Excel files (including .gz) instantly and lets you filter, query with SQL, chart and export them without loading them into RAM.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "csv",
          "tsv",
          "tab"
        ],
        "name": "Delimited text data",
        "description": "Comma- or tab-separated data",
        "role": "Viewer",
        "mimeType": "text/csv"
      },
      {
        "ext": [
          "json",
          "ndjson",
          "jsonl"
        ],
        "name": "JSON data",
        "description": "JSON or newline-delimited JSON data",
        "role": "Viewer",
        "mimeType": "application/json"
      },
      {
        "ext": [
          "parquet"
        ],
        "name": "Parquet data",
        "description": "Apache Parquet data",
        "role": "Viewer",
        "mimeType": "application/vnd.apache.parquet"
      },
      {
        "ext": [
          "xlsx",
          "xls"
        ],
        "name": "Excel workbook",
        "description": "Excel workbook",
        "role": "Viewer",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      },
      {
        "ext": [
          "sqlite",
          "sqlite3",
          "db3"
        ],
        "name": "SQLite database",
        "description": "SQLite database",
        "role": "Viewer",
        "mimeType": "application/vnd.sqlite3"
      },
      {
        "ext": [
          "duckdb",
          "ddb"
        ],
        "name": "DuckDB database",
        "description": "DuckDB database",
        "role": "Viewer",
        "mimeType": "application/x-duckdb"
      },
      {
        "ext": [
          "dataliq"
        ],
        "name": "DataLiq workspace",
        "description": "DataLiq workspace: open tabs, views and SQL",
        "role": "Editor",
        "mimeType": "application/x-dataliq-workspace"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
