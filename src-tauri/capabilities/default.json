{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimum permissions for the main window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-run-query",
    "allow-cancel-query",
    "allow-fetch-rows",
    "allow-open-file",
    "allow-preview-file",
    "allow-import-file",
    "allow-cancel-import",
    "allow-open-direct",
    "allow-close-dataset",
    "allow-cache-info",
    "allow-clear-cache",
    "allow-get-settings",
    "allow-take-startup-files",
    "allow-open-view",
    "allow-column-values",
    "allow-column-profile",
    "allow-column-histograms",
    "allow-view-sql",
    "allow-register-table",
    "allow-unregister-table",
    "allow-sql-result",
    "allow-sql-history",
    "allow-add-sql-history",
    "allow-clear-sql-history",
    "allow-saved-queries",
    "allow-save-query",
    "allow-delete-saved-query",
    "allow-export-view",
    "allow-cancel-export",
    "allow-chart-data",
    "allow-chart-sql",
